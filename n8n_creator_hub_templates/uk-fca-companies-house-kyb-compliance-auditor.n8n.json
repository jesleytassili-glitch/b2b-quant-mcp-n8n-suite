        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"companyQuery\": \"Barclays,Revolut\",\n  \"includeFcaCheck\": true,\n  \"maxResults\": 5\n}",
