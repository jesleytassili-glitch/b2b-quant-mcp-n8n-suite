        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"coordinatesList\": \"40.7128,-74.0060; 25.7617,-80.1918; 30.2672,-97.7431\",\n  \"censusYear\": \"2020\",\n  \"maxResults\": 5\n}",
