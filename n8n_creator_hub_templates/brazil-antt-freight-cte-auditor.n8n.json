        "url": "https://api.apify.com/v2/acts/b2b-quant-apis~brazil-antt-freight-cte-auditor/run-sync-get-dataset-items",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"routes\": [\n    {\n      \"origin_uf\": \"SP\",\n      \"dest_uf\": \"RJ\",\n      \"distance_km\": 430,\n      \"axles\": 6,\n      \"cargo_type\": \"geral\"\n    }\n  ]\n}",
