        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ actor: 'us-clinical-trials-biotech-radar', timestamp: $now, record: $json }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "5cbb82e6-928e-5550-8624-9306be1d6b3f",
